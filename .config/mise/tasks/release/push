#!/usr/bin/env bash
#MISE description="Push the tagged release to GitHub — run after release:tag (hardware key touch)"
set -euo pipefail
# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

echo ""
echo -e "${bold}🚀 Pushing release…${reset}"
echo ""

detect_vcs
info "VCS: ${VCS}"

# ── resolve the version being released from CHANGELOG.md ─────────────────────
# Not "the newest v* tag in the repo": run before release:tag has tagged
# anything, that resolves to the *previous* release, pushes nothing new, and
# then tries to drag main backwards onto it. The changelog names the release
# that prepare and tag produced, and the tag for it must already exist.
version=$(sed -n 's/^## \[\(v[0-9][^]]*\)\].*/\1/p' CHANGELOG.md | head -1)
[[ -n "${version}" ]] \
  || die "no version heading in CHANGELOG.md — run 'mise run release:prepare' first"
git rev-parse -q --verify "refs/tags/${version}" > /dev/null \
  || die "${version} is not tagged locally — run 'mise run release:tag' first"
info "Version: ${bold}${version}${reset}"
echo ""

# ── advance main bookmark to the tagged commit ────────────────────────────────
if [[ "${VCS}" == "jj" ]]; then
  info "Advancing main bookmark to ${version}…"
  advance_main_bookmark "${version}"
fi

# ── push branch ───────────────────────────────────────────────────────────────
# The branch goes alone: `jj git push --all` pushes bookmarks AND tags (jj has
# pushed tags since 0.36), which would send all six tags in one push and undo
# the staging below. --bookmark keeps the tags out of it.
if [[ "${VCS}" == "jj" ]]; then
  info "Pushing bookmark (requires hardware key)…"
  jj git push --bookmark main
else
  info "Pushing branch…"
  HK=0 git push origin HEAD
fi
success "Branch pushed"

# ── push root tag alone first ─────────────────────────────────────────────────
# GitHub suppresses push events when > 3 tags are pushed at once, so the root
# tag must be pushed separately to reliably trigger GitHub Actions.
info "Pushing root tag ${version} (triggers GitHub Actions)…"
if [[ "${VCS}" == "jj" ]]; then
  jj git push --tag "${version}"
else
  HK=0 git push origin "refs/tags/${version}"
fi
success "Root tag pushed"

# ── push sub-module tags ──────────────────────────────────────────────────────
info "Pushing sub-module tags…"
if [[ "${VCS}" == "jj" ]]; then
  jj git push --all
else
  HK=0 git push --tags
fi
success "Sub-module tags pushed"

# ── update GitHub release notes from CHANGELOG.md ────────────────────────────
info "Updating GitHub release notes…"
notes=$(awk '/^## \[/{if(p) exit; p=1; next} p' CHANGELOG.md | sed '/./,$!d')
if gh release view "${version}" &>/dev/null; then
  gh release edit "${version}" --notes "${notes}"
else
  gh release create "${version}" --title "${version}" --notes "${notes}"
fi
success "Release notes updated"

echo ""
echo -e "  ${green}${bold}✓ Release ${version} is live.${reset}"
echo ""
echo -e "  ${yellow}Next:${reset} Update go.sum files with the published module checksums:"
echo -e "  ${bold}mise run release:post-tidy${reset}"
echo ""
